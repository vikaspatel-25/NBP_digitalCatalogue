<a href="/home/article?id=<%= article._id %>" class="w-full flex gap-3.5 border border-gray-200 rounded-md overflow-hidden no-underline text-inherit bg-white transition-shadow duration-200 hover:shadow-[0_4px_10px_rgba(0,0,0,0.1)] group">
  <div class="w-[140px] h-[110px] shrink-0 bg-gray-50 flex items-center justify-start pl-1.5 overflow-hidden">
    <% if(article.coverImage){ %>
      <img src="<%= article.coverImage %>" loading="lazy" alt="<%= article.title %>" class="max-w-full max-h-full object-cover rounded-sm group-hover:scale-105 transition-transform duration-300">
    <% } else { %>
      <img src="/images/placeholder.png" loading="lazy" alt="No image" class="max-w-full max-h-full object-cover">
    <% } %>
  </div>
  <div class="py-2.5 pr-3 flex flex-col justify-center gap-1.5 overflow-hidden">
    <h3 class="text-[clamp(14px,1.1vw,17px)] font-semibold m-0 leading-snug line-clamp-2 text-gray-900 group-hover:text-[#0158a0] transition-colors">
      <%= article.title %>
    </h3>
    <p class="text-[clamp(13px,0.95vw,14px)] text-gray-600 m-0 leading-relaxed line-clamp-3">
      <%= article.content.replace(/<[^>]*>?/gm,'').substring(0,140) %>...
    </p>
  </div>
</a>