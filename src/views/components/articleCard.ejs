<a href="/home/article?id=<%= article._id %>" class="article-card">

<div class="article-image">

<% if(article.coverImage){ %>

<img
src="<%= article.coverImage %>"
loading="lazy"
alt="<%= article.title %>"
>

<% } else { %>

<img
src="/images/placeholder.png"
loading="lazy"
alt="No image"
>

<% } %>

</div>

<div class="article-content">

<h3 class="article-title">
<%= article.title %>
</h3>

<p class="article-excerpt">
<%= article.content
.replace(/<[^>]*>?/gm,'')
.substring(0,140) %>...
</p>

</div>

</a>


<style>

.article-card{
width: 100%;
display:flex;
gap:14px;

border:1px solid #e2e2e2;
border-radius:6px;

overflow:hidden;
text-decoration:none;
color:inherit;

background:white;

transition:0.2s;

}

.article-card:hover{

box-shadow:0 4px 10px rgba(0,0,0,0.1);

}


/* Image area */

.article-image{

width:140px;
height:110px;

flex-shrink:0;

background:#f5f5f5;

display:flex;
align-items:center;      /* vertical center */
justify-content:flex-start; /* horizontal left */

padding-left:6px;

overflow:hidden;

}


/* Natural image fit */

.article-image img{

max-width:100%;
max-height:100%;

object-fit:cover;

}


/* Content */

.article-content{

padding:10px 12px 10px 0;

display:flex;
flex-direction:column;
justify-content:center;
gap:6px;

overflow:hidden;

}


/* Responsive readable title */

.article-title{

font-size:clamp(14px,1.1vw,17px);
font-weight:600;

margin:0;

line-height:1.3;

overflow:hidden;

display:-webkit-box;
-webkit-line-clamp:2;
-webkit-box-orient:vertical;

}


/* Excerpt */

.article-excerpt{

font-size:clamp(13px,0.95vw,14px);

color:#555;
margin:0;

line-height:1.4;

display:-webkit-box;
-webkit-line-clamp:3;
-webkit-box-orient:vertical;

overflow:hidden;

}

</style>