<div class="group relative flex flex-col bg-white rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 overflow-hidden cursor-pointer" onclick="window.location.href='/home/product?id=<%= product._id %>'">
  <!-- Image Container -->
  <div class="w-full aspect-[4/3] bg-slate-50 relative overflow-hidden flex items-center justify-center p-4">
    <% if (product.images && product.images.length) { %>
      <img
        src="<%= product.images[0] %>"
        alt="<%= product.productName %>"
        loading="lazy"
        class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
      />
    <% } else { %>
      <img
        src="/images/placeholder.png"
        alt="Product preview"
        loading="lazy"
        class="w-full h-full object-contain opacity-70 group-hover:scale-105 transition-transform duration-300"
      />
    <% } %>

    <!-- Subtle Brand / Category Tag -->
    <% if (product.companyName && product.companyName.toLowerCase() !== 'admin') { %>
      <div class="absolute top-3 left-3 bg-white/90 backdrop-blur-xs border border-slate-200/80 text-[10px] font-bold text-slate-700 px-2.5 py-1 rounded-full shadow-2xs">
        <%= product.companyName %>
      </div>
    <% } %>
  </div>

  <!-- Content Container -->
  <div class="p-4 sm:p-5 flex flex-col justify-between flex-1 gap-3">
    <div class="space-y-1.5">
      <h3 class="text-sm sm:text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-1 leading-snug">
        <%= product.productName %>
      </h3>
      <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
        <%= product.shortDescription || product.detailedDescription %>
      </p>
    </div>

    <!-- Pricing & Action Footer -->
    <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2">
      <div>
        <div class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Estimated Price</div>
        <div class="text-xs sm:text-sm font-black text-emerald-700">
          ₹<%= Number(product.priceMin || 0).toLocaleString('en-IN') %> - ₹<%= Number(product.priceMax || 0).toLocaleString('en-IN') %>
          <% if (product.priceNote) { %>
            <span class="text-[10px] font-normal text-slate-400">(<%= product.priceNote %>)</span>
          <% } %>
        </div>
      </div>

      <button
        type="button"
        onclick="event.stopPropagation(); window.location.href='/home/product?id=<%= product._id %>'"
        class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl bg-blue-50 text-blue-700 group-hover:bg-blue-600 group-hover:text-white text-xs font-bold transition-all"
      >
        <span>Details</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </div>
  </div>
</div>
