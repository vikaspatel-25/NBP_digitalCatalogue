<div class="group relative flex flex-col bg-white rounded-xl sm:rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 overflow-hidden cursor-pointer h-full" onclick="window.location.href='/home/product?id=<%= product._id %>'">
  <!-- Image Container -->
  <div class="w-full aspect-square sm:aspect-[4/3] bg-slate-50 relative overflow-hidden flex items-center justify-center p-2.5 sm:p-4">
    <% if (product.images && product.images.length) { %>
      <img
        src="<%= product.images[0] %>"
        alt="<%= product.productName %>"
        loading="lazy"
        class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
      />
    <% } else { %>
      <img
        src="/images/placeholder.png"
        alt="Product preview"
        loading="lazy"
        class="w-full h-full object-contain opacity-70 group-hover:scale-105 transition-transform duration-300"
      />
    <% } %>

    <!-- Subtle Brand / Category Tag -->
    <% if (product.companyName && product.companyName.toLowerCase() !== 'admin') { %>
      <div class="absolute top-2 left-2 sm:top-3 sm:left-3 bg-white/90 backdrop-blur-xs border border-slate-200/80 text-[9px] sm:text-[10px] font-bold text-slate-700 px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-full shadow-2xs max-w-[85%] truncate">
        <%= product.companyName %>
      </div>
    <% } %>
  </div>

  <!-- Content Container -->
  <div class="p-3 sm:p-5 flex flex-col justify-between flex-1 gap-2 sm:gap-3">
    <div class="space-y-1">
      <h3 class="text-xs sm:text-base font-bold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-1 leading-snug">
        <%= product.productName %>
      </h3>
      <p class="text-[11px] sm:text-xs text-slate-500 line-clamp-2 leading-tight sm:leading-relaxed">
        <%= product.shortDescription || product.detailedDescription %>
      </p>
    </div>

    <!-- Pricing & Action Footer -->
    <div class="pt-2 sm:pt-3 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
      <div class="min-w-0">
        <div class="text-[9px] sm:text-[10px] uppercase font-bold text-slate-400 tracking-wider">Est. Price</div>
        <div class="text-xs sm:text-sm font-black text-emerald-700 truncate">
          ₹<%= Number(product.priceMin || 0).toLocaleString('en-IN') %> - ₹<%= Number(product.priceMax || 0).toLocaleString('en-IN') %>
        </div>
        <% if (product.priceNote) { %>
          <div class="text-[9px] text-slate-400 truncate">(<%= product.priceNote %>)</div>
        <% } %>
      </div>

      <button
        type="button"
        onclick="event.stopPropagation(); window.location.href='/home/product?id=<%= product._id %>'"
        class="w-full sm:w-auto justify-center inline-flex items-center gap-1 px-2.5 py-1 sm:px-3 sm:py-1.5 rounded-lg sm:rounded-xl bg-blue-50 text-blue-700 group-hover:bg-blue-600 group-hover:text-white text-[11px] sm:text-xs font-bold transition-all"
      >
        <span>Details</span>
        <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>
    </div>
  </div>
</div>
