<a href="/home/product?id=<%= product._id %>" class="flex flex-col no-underline text-inherit rounded-lg overflow-hidden bg-white shadow-[0_3px_10px_rgba(0,0,0,0.08)] hover:shadow-[0_6px_16px_rgba(0,0,0,0.12)] hover:-translate-y-1 transition-all duration-200 cursor-pointer w-full group">
  <div class="w-full aspect-[4/3] bg-gray-100 flex items-center justify-center overflow-hidden relative">
    <% if (product.images && product.images.length) { %>
      <img src="<%= product.images[0] %>" alt="<%= product.productName %>" loading="lazy" class="w-full h-full object-contain block" />
    <% } else { %>
      <img src="/images/placeholder.png" alt="No product image" loading="lazy" class="w-full h-full object-contain block" />
    <% } %>
  </div>

  <div class="p-3 flex flex-col gap-1.5 flex-grow">
    <h3 class="text-sm font-bold m-0 leading-tight whitespace-nowrap overflow-hidden text-ellipsis text-gray-900 group-hover:text-[#0158a0] transition-colors">
      <%= product.productName %>
    </h3>

    <p class="text-xs text-gray-600 leading-snug mt-2.5 line-clamp-4 flex-grow">
      <%= product.shortDescription || product.detailedDescription %>
    </p>

    <div class="text-xs font-semibold my-3 text-[#044202] text-left">
      ₹ <%= product.priceMin %> - ₹ <%= product.priceMax %>
      <% if (product.priceNote) { %>
        <span class="font-normal text-gray-500">(<%= product.priceNote %>)</span>
      <% } %>
    </div>
    
    <button type="button" class="mt-1.5 self-start px-2.5 py-1.5 text-[11px] font-medium rounded-md border-none bg-[#529f23] text-white cursor-pointer hover:bg-[#0158a0] transition-colors" onclick="event.preventDefault(); window.location.href='/home/product?id=<%= product._id %>'">
      View Details
    </button>
  </div>
</a>
