<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Base Layout</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --orange: #0158A0;
        --orange-dark: #066422;
        --text-dark: #1f1f1f;
        --ui-light: #e2e2e2;
        --ui-soft: #f1f1f1;
        --white: #ffffff;
        --radius: 6px;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont,
          sans-serif;
      }

      body {
        background: var(--white);
        color: var(--text-dark);
      }

      header {
        width: 100%;
        background: var(--white);
        border-bottom: 1px solid var(--ui-light);
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
      }

      .header-inner {
        max-width: 1400px;
        margin: 0 auto;
        height: 72px;
        padding: 0 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .brand {
        height: 100%;
        display: flex;
        align-items: center;
      }

      .brand img {
        height: 100%;
        max-height: 100%;
        width: auto;
        
        object-fit: contain;
        display: block;
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .action-btn {
        padding: 9px 16px;
        font-size: 13px;
        font-weight: 500;
        border-radius: var(--radius);
        cursor: pointer;
        border: 1px solid transparent;
      }

      .action-btn.contact {
        background: var(--ui-soft);
        color: var(--text-dark);
        border-color: var(--ui-light);
      }

      .action-btn.admin {
        background: var(--orange);
        color: var(--white);
      }

      .action-btn.admin:hover {
        background: var(--orange-dark);
      }

      .hamburger {
        display: none;
        font-size: 20px;
        cursor: pointer;
        line-height: 1;
      }

      .overlay {
        position: fixed;
        inset: 0;
        z-index: 1;
        background: rgba(0, 0, 0, 0.25);
        display: none;
      }

      .overlay.active {
        display: block;
      }

      .drawer {
        position: fixed;
        z-index: 3;
        top: 0;
        right: -280px;
        width: 280px;
        height: 100%;
        background: var(--white);
        border-left: 1px solid var(--ui-light);
        transition: right 0.3s ease;
        display: flex;
        flex-direction: column;
      }

      .drawer.open {
        right: 0;
      }

      .drawer-header {
        height: 72px;
        padding: 0 20px;
        border-bottom: 1px solid var(--ui-light);
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .drawer-header img {
        height: 100%;
        max-height: 100%;
        width: auto;
        object-fit: contain;
        display: block;
      }

      .close-btn {
        font-size: 18px;
        cursor: pointer;
        background: none;
        border: none;
      }

      .drawer-content {
        padding: 28px 20px;
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      .drawer-content a {
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        color: var(--text-dark);
        padding: 10px 12px;
        border-radius: var(--radius);
        background: var(--ui-soft);
      }

      main {
        width: 100%;
      }

      .site-container {
        max-width: 1320px;
        margin: 0 auto;
        min-height: 100vh;
        padding: 24px;
      }

      .product-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
      }

      @media (max-width: 1200px) {
        .product-grid {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      @media (max-width: 900px) {
        .product-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 768px) {
        .header-actions {
          display: none;
        }

        .hamburger {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 36px;
          height: 36px;
          border-radius: 50%;
          background: var(--ui-soft);
        }

        .site-container {
          max-width: 99%;
        }
      }
    </style>
  </head>

  <body>
    
    <%- include('../components/header.ejs') %>
    
    
    <div id="navBarContainer"
     style="width: 100%; max-width: 400px; aspect-ratio: 400 / 65; display: flex; align-items: center; justify-content: center; margin: 0 auto;">

    <div id="navBar" class="nav-bar"
       style="height: 70%; width: 85%; border-radius: 999px; background-color: #f2f2f2; display: flex; align-items: center; justify-content: space-between; padding: 1.5%;">

    <div id="tab1" class="n-tab" onclick="handleTabClick(event)"
         style="height: 100%; width: 50%; border-radius: 999px; font-family: Roboto, sans-serif; color: #ffffff; font-size: clamp(12px, 3vw, 15px); display: flex; align-items: center; justify-content: center; font-weight: 700; cursor: pointer; overflow: hidden; margin: 0 2px; background-color: rgb(1, 88, 160);">
      Products
    </div>

    <div id="tab2" class="n-tab" onclick="handleTabClick(event)"
         style="height: 100%; width: 50%; border-radius: 999px; font-family: Roboto, sans-serif; color: #000000; font-size: clamp(12px, 3vw, 15px); display: flex; align-items: center; justify-content: center; font-weight: 700; cursor: pointer; overflow: hidden; margin: 0 2px;">
      Articles
    </div>

   </div>
</div>


    <main>
      <div class="site-container">
        <div class="product-grid" id="product-grid">
          <% for (const product of products) { %>
            <%- include('../components/prodCard.ejs', { product }) %>
          <% } %>
        </div>
        <div class="article-grid product-grid" id="article-grid">
         Articles will be displayed here
        </div>
      </div>
    </main>

    <script>function handleTabClick(event) {
      let allTabs = Array.from(document.getElementsByClassName('n-tab'));
      
      // reset the styles for all tabs
      allTabs.forEach(tab => {
      tab.style.backgroundColor = '#f2f2f2';
      tab.style.color = '#000000';
      
      });
      
      // retrieve the clicked tab and set its styles
      let tabClicked = event.target;
      tabClicked.style.backgroundColor = '#0158a0';
      tabClicked.style.color = '#ffffff';
      
      let tabClickedId = event.target.getAttribute('id');
      if (tabClickedId === 'tab1') {
      document.getElementById('article-grid').style.display = 'none';
      document.getElementById('product-grid').style.display = 'grid';
      } 
      else if (tabClickedId === 'tab2') {
      document.getElementById('article-grid').style.display = 'flex';
      document.getElementById('product-grid').style.display = 'none';
      }

      return tabClickedId;
      };</script>
    
  </body>
</html>
