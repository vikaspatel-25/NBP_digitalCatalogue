<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NetZeroMart | Sustainable Digital Catalogue & Eco-Friendly Innovations</title>
    
    <link rel="canonical" href="https://netzeromart.com/">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    
    <!-- Favicon & Icons -->
    <link rel="icon" type="image/png" href="/assets/netZeroStickerIcon.png" />
    <link rel="apple-touch-icon" href="/assets/netZeroStickerIcon.png" />
    
    <!-- SEO & OpenGraph -->
    <meta name="description" content="Discover verified net-zero technologies, eco-friendly industrial products, and sustainable architecture case studies on NetZeroMart." />
    <meta name="theme-color" content="#0158a0" />
    <meta property="og:title" content="NetZeroMart - Sustainable Commerce & Catalogue" />
    <meta property="og:description" content="Browse net-zero innovations, renewable solutions, and verified manufacturer specs." />
    <meta property="og:image" content="/assets/netZeroStickerIcon.png" />
    <meta property="og:type" content="website" />
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: {
                blue: '#0158a0',
                green: '#529f23',
                darkBlue: '#004a87',
                darkGreen: '#044202'
              }
            },
            fontFamily: {
              sans: ['Inter', 'system-ui', 'sans-serif'],
            }
          }
        }
      }
    </script>
    <style>
      .slider-viewport { 
        overflow-x: auto; 
        scroll-behavior: smooth; 
        -webkit-overflow-scrolling: touch; 
        scrollbar-width: none; 
        -ms-overflow-style: none; 
      }
      .slider-viewport::-webkit-scrollbar { display: none; }
    </style>
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased font-sans flex flex-col min-h-screen selection:bg-blue-600 selection:text-white">
    <%- include('../components/header.ejs') %>

    <main class="w-full flex-grow">
      <!-- Modern Hero Banner (Desktop / Tablet only) -->
      <section class="hidden md:block max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-6">
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 text-white p-8 sm:p-12 md:p-16 shadow-xl border border-slate-800">
          <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-blue-600/20 blur-3xl pointer-events-none"></div>
          <div class="absolute -left-20 -top-20 w-80 h-80 rounded-full bg-emerald-500/15 blur-3xl pointer-events-none"></div>

          <div class="relative z-10 max-w-3xl space-y-4">
            <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-500/20 border border-blue-400/30 text-blue-300 text-xs font-bold uppercase tracking-wider">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Sustainable Industrial Innovation
            </div>

            <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight leading-tight">
              The Digital Catalogue for <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-emerald-400">Net-Zero Products</span>
            </h1>

            <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-2xl">
              Explore verified clean technologies, sustainable building materials, and eco-innovations. Directly connect with registered manufacturers and suppliers worldwide.
            </p>

            <div class="pt-2 flex flex-wrap items-center gap-3 text-xs">
              <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/10 backdrop-blur-xs text-slate-200 border border-white/10">
                <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                <span>Verified Vendors</span>
              </div>
              <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/10 backdrop-blur-xs text-slate-200 border border-white/10">
                <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                <span>Transparent Specs</span>
              </div>
              <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/10 backdrop-blur-xs text-slate-200 border border-white/10">
                <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                <span>Instant Inquiries</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Navigation Segment Tabs -->
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-2 sm:py-4">
        <div class="flex items-center justify-center">
          <div class="inline-flex p-1.5 rounded-2xl bg-white border border-slate-200/80 shadow-xs gap-1.5">
            <button
              id="tab1"
              onclick="handleTabClick(event)"
              class="n-tab px-6 py-2.5 rounded-xl text-xs sm:text-sm font-bold text-white bg-blue-600 shadow-sm cursor-pointer transition-all duration-200 flex items-center gap-2"
            >
              <span>Products</span>
              <span class="px-2 py-0.5 rounded-full bg-white/20 text-[11px] font-semibold"><%= products.length %></span>
            </button>
            <button
              id="tab2"
              onclick="handleTabClick(event)"
              class="n-tab px-6 py-2.5 rounded-xl text-xs sm:text-sm font-bold text-slate-600 hover:text-slate-900 cursor-pointer transition-all duration-200 flex items-center gap-2 hover:bg-slate-100"
            >
              <span>Educational Articles</span>
              <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 text-[11px] font-semibold"><%= articles.length %></span>
            </button>
          </div>
        </div>
      </section>

      <!-- Main Catalogue Content Area -->
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
        <!-- Featured Articles Horizontal Carousel (Desktop / Tablet) -->
        <% if (articles && articles.length > 0) { %>
          <div class="hidden md:block mb-10 w-full article-slider relative">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-sm uppercase tracking-wider font-extrabold text-slate-400">Featured Insights & Stories</h2>
              <span class="text-xs text-slate-400">Scroll to explore</span>
            </div>
            <div class="slider-viewport" id="sliderViewport">
              <div class="flex gap-5 pb-2 w-max">
                <% for (const article of articles) { %>
                  <div class="slide flex-none w-[300px] sm:w-[340px] snap-center">
                    <%- include('../components/articleCard.ejs', { article }) %>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        <% } %>

        <!-- Products Grid (2 columns on mobile for multi-product visibility) -->
        <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2.5 sm:gap-6 product-grid" id="product-grid">
          <% if (products && products.length > 0) { %>
            <% for (const product of products) { %>
              <%- include('../components/prodCard.ejs', { product }) %>
            <% } %>
          <% } else { %>
            <div class="col-span-full py-16 text-center bg-white rounded-3xl border border-slate-200/80 p-8">
              <div class="w-16 h-16 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900">No products listed currently</h3>
              <p class="text-sm text-slate-500 mt-1">Check back soon or register as a vendor to list your innovations.</p>
            </div>
          <% } %>
        </div>

        <!-- Full Articles Grid -->
        <div class="hidden grid-cols-1 md:grid-cols-2 gap-6 article-grid" id="article-grid">
          <% if (articles && articles.length > 0) { %>
            <% for (const article of articles) { %>
              <%- include('../components/articleCard.ejs', { article }) %>
            <% } %>
          <% } else { %>
            <div class="col-span-full py-16 text-center bg-white rounded-3xl border border-slate-200/80 p-8">
              <h3 class="text-lg font-bold text-slate-900">No articles published yet</h3>
              <p class="text-sm text-slate-500 mt-1">Articles and guides will appear here once published.</p>
            </div>
          <% } %>
        </div>
      </section>
    </main>

    <%- include('../components/footer.ejs') %>

    <script>
      window.addEventListener("load", function() {
        const viewport = document.getElementById("sliderViewport");
        if (!viewport) return;
        let index = 0;
        function slideWidth() { 
          const slide = document.querySelector(".slide");
          return slide ? slide.offsetWidth + 20 : 0; 
        }
        function autoSlide() {
          const slideNodes = document.querySelectorAll(".slide");
          if (!slideNodes.length) return;
          const width = slideWidth();
          index++;
          if (index >= slideNodes.length) { index = 0; }
          viewport.scrollTo({ left: index * width, behavior: "smooth" });
        }
        setInterval(autoSlide, 5000);
      });

      function handleTabClick(event) {
        const tabClicked = event.currentTarget;
        const allTabs = document.querySelectorAll('.n-tab');
        
        allTabs.forEach(tab => {
          tab.classList.remove('bg-blue-600', 'text-white', 'shadow-sm');
          tab.classList.add('text-slate-600');
        });
        
        tabClicked.classList.remove('text-slate-600');
        tabClicked.classList.add('bg-blue-600', 'text-white', 'shadow-sm');
        
        const tabClickedId = tabClicked.getAttribute('id');
        const articleGrid = document.getElementById('article-grid');
        const productGrid = document.getElementById('product-grid');
        const articleSlider = document.querySelector('.article-slider');

        if (tabClickedId === 'tab1') {
          articleGrid.className = 'hidden grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 article-grid';
          productGrid.className = 'grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2.5 sm:gap-6 product-grid';
          if (articleSlider) articleSlider.style.display = '';
        } else if (tabClickedId === 'tab2') {
          articleGrid.className = 'grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 article-grid';
          productGrid.className = 'hidden product-grid';
          if (articleSlider) articleSlider.style.display = 'none';
        }
      }
    </script>
  </body>
</html>
