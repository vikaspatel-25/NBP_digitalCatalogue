<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NetZeroMart</title>
    
    <link rel="canonical" href="https://netzeromart.com/">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="/assets/netZeroStickerIcon.png" type="image/png">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: {
                blue: '#0158a0',
                green: '#529f23',
                darkBlue: '#004a87',
                darkGreen: '#044202'
              }
            },
            fontFamily: {
              sans: ['Inter', 'system-ui', 'sans-serif'],
            }
          }
        }
      }
    </script>
    <style>
      .slider-viewport{ overflow-x:auto; scroll-behavior:smooth; -webkit-overflow-scrolling:touch; scrollbar-width:none; -ms-overflow-style:none; }
      .slider-viewport::-webkit-scrollbar{ display:none; }
    </style>
  </head>
  <body class="bg-white text-gray-900 antialiased font-sans flex flex-col min-h-screen">
    <%- include('../components/header.ejs') %>

    <div class="w-full max-w-[400px] aspect-[400/65] flex items-center justify-center mx-auto my-6 px-4">
      <div class="h-[70%] w-[85%] rounded-full bg-gray-100 flex items-center justify-between p-1 shadow-inner relative">
        <div id="tab1" class="n-tab h-full w-1/2 rounded-full text-white text-[clamp(12px,3vw,15px)] flex items-center justify-center font-bold cursor-pointer mx-0.5 bg-brand-blue transition-colors duration-200 z-10" onclick="handleTabClick(event)">Products</div>
        <div id="tab2" class="n-tab h-full w-1/2 rounded-full text-gray-800 text-[clamp(12px,3vw,15px)] flex items-center justify-center font-bold cursor-pointer mx-0.5 transition-colors duration-200 z-10 hover:bg-gray-200" onclick="handleTabClick(event)">Articles</div>
      </div>
    </div>

    <main class="w-full flex-grow">
      <div class="max-w-[1320px] mx-auto px-5 pb-12 w-full md:w-[99%] lg:w-full">
        
        <div class="mb-8 w-full article-slider relative">
          <div class="slider-viewport" id="sliderViewport">
            <div class="flex gap-5 pb-1.5 w-max">
              <% for (const article of articles) { %>
                <div class="slide flex-none w-[320px] max-w-[320px] snap-center">
                  <%- include('../components/articleCard.ejs', { article }) %>
                </div>
              <% } %>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5 product-grid" id="product-grid">
          <% for (const product of products) { %>
            <%- include('../components/prodCard.ejs', { product }) %>
          <% } %>
        </div>

        <div class="hidden grid-cols-1 md:grid-cols-2 gap-5 article-grid" id="article-grid">
          <% for (const article of articles) { %>
            <div class="flex justify-center w-full">
              <%- include('../components/articleCard.ejs', { article }) %>
            </div>
          <% } %>
        </div>

      </div>

      <script>
        window.addEventListener("load", function(){
          const viewport = document.getElementById("sliderViewport");
          let index = 0;
          function slideWidth(){ 
            const slide = document.querySelector(".slide");
            return slide ? slide.offsetWidth + 20 : 0; 
          }
          function autoSlide(){
            const slideNodes = document.querySelectorAll(".slide");
            if (!slideNodes.length) return;
            const width = slideWidth();
            index++;
            if(index >= slideNodes.length){ index = 0; }
            viewport.scrollTo({ left:index * width, behavior:"smooth" });
          }
          setInterval(autoSlide,4000);
        });

        function handleTabClick(event) {
          let allTabs = Array.from(document.getElementsByClassName('n-tab'));
          allTabs.forEach(tab => { 
            tab.classList.remove('bg-brand-blue', 'text-white');
            tab.classList.add('text-gray-800');
            tab.style.backgroundColor = 'transparent';
          });
          
          let tabClicked = event.target;
          tabClicked.classList.remove('text-gray-800');
          tabClicked.classList.add('bg-brand-blue', 'text-white');
          
          let tabClickedId = tabClicked.getAttribute('id');
          const articleGrid = document.getElementById('article-grid');
          const productGrid = document.getElementById('product-grid');
          const articleSlider = document.querySelector('.article-slider');

          if (tabClickedId === 'tab1') {
            articleGrid.className = 'hidden grid-cols-1 md:grid-cols-2 gap-5 article-grid';
            productGrid.className = 'grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5 product-grid';
            articleSlider.style.display = 'block';
          } else if (tabClickedId === 'tab2') {
            articleGrid.className = 'grid grid-cols-1 md:grid-cols-2 gap-5 article-grid show';
            productGrid.className = 'hidden product-grid';
            articleSlider.style.display = 'none';
          }
          return tabClickedId;
        }
      </script>
    </main>
    <%- include('../components/footer.ejs') %>
  </body>
</html>
