<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>User Login</title>

  <style>
    :root {
      --bg: #f4f6f8;
      --panel: #ffffff;
      --border: #e5e7eb;
      --text: #1f2937;
      --muted: #6b7280;
      --header-bg: #1e3a8a;
      --header-text: #ffffff;
      --primary: #2563eb;
      --primary-hover: #1e4ed8;
      --input-bg: #f9fafb;
      --focus: #2563eb;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      background: var(--bg);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: var(--text);
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding: 8vh 1rem;
    }

    .panel {
      width: 100%;
      max-width: 460px;
      background: var(--panel);
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 12px 30px rgba(0,0,0,0.08), 0 4px 10px rgba(0,0,0,0.05);
    }

    .panel-header {
      padding: 1.6rem 2rem;
      background: var(--header-bg);
      color: var(--header-text);
    }

    .panel-header h1 {
      margin: 0;
      font-size: 1.3rem;
      font-weight: 600;
    }

    .panel-header p {
      margin-top: 0.35rem;
      font-size: 0.85rem;
      opacity: 0.85;
    }

    .panel-body { padding: 1.8rem 2rem 2.2rem; }

    .field { margin-bottom: 1.2rem; }

    .field label {
      display: block;
      margin-bottom: 0.4rem;
      font-size: 0.8rem;
      color: var(--muted);
    }

    .input-wrapper input,
    .password-wrapper input {
      width: 100%;
      padding: 0.65rem 0.75rem;
      font-size: 0.9rem;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: var(--input-bg);
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .password-wrapper {
      position: relative;
    }

    .password-wrapper input {
      padding-right: 2.8rem;
    }

    .input-wrapper input:focus,
    .password-wrapper input:focus {
      outline: none;
      border-color: var(--focus);
      box-shadow: 0 0 0 2px rgba(37,99,235,0.15);
      background: #ffffff;
    }

    .toggle-btn {
      position: absolute;
      top: 50%;
      right: 0.55rem;
      transform: translateY(-50%);
      padding: 0.25rem 0.45rem;
      font-size: 0.7rem;
      border-radius: 4px;
      border: 1px solid var(--border);
      background: #ffffff;
      color: var(--muted);
      cursor: pointer;
    }

    .small-note {
      font-size: 0.75rem;
      color: var(--muted);
      margin-top: 0.35rem;
    }

    .actions {
      margin-top: 1.6rem;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }

    .login-btn {
      padding: 0.65rem 1.2rem;
      font-size: 0.85rem;
      font-weight: 500;
      border-radius: 6px;
      border: none;
      background: var(--primary);
      color: #ffffff;
      cursor: pointer;
      transition: background 0.15s ease;
    }

    .login-btn:hover { background: var(--primary-hover); }

    .link-btn {
      background: none;
      border: none;
      color: var(--primary);
      font-size: 0.8rem;
      cursor: pointer;
      text-align: left;
      padding: 0;
    }

    .link-btn:hover { text-decoration: underline; }

    .back-link {
      margin-top: 1.5rem;
      text-align: center;
      font-size: 0.85rem;
    }

    .back-link a {
      text-decoration: none;
      color: var(--text);
    }
  </style>

  <script>
    function togglePassword() {
      const input = document.getElementById("password");
      const btn = document.getElementById("toggleBtn");
      if (input.type === "password") {
        input.type = "text";
        btn.textContent = "Hide";
      } else {
        input.type = "password";
        btn.textContent = "Show";
      }
    }

    function handleForgotPassword() {
      const emailInput = document.getElementById("gmail");
      const email = emailInput.value.trim();
      const gmailPattern = /^[a-zA-Z0-9._%+-]+@gmail\.com$/;

      if (!gmailPattern.test(email)) {
        emailInput.focus();
        emailInput.setCustomValidity("Please enter a valid Gmail address before requesting a passkey.");
        emailInput.reportValidity();
        return;
      }

      emailInput.setCustomValidity("");
      window.location.href = "/userPanel/forgotPassword?gmail=" + encodeURIComponent(email);
    }
  </script>
</head>

<body>
  <div class="panel">
    <div class="panel-header">
      <h1>User Login</h1>
      <p>Access your account</p>
    </div>

    <div class="panel-body">
      <form action="/userLogin" method="POST">

        <div class="field">
          <label for="gmail">Gmail Address</label>
          <div class="input-wrapper">
            <input 
              type="email"
              id="gmail"
              name="gmail"
              required
              pattern="^[a-zA-Z0-9._%+-]+@gmail\.com$"
              title="Please enter a valid Gmail address (example@gmail.com)"
              oninput="this.setCustomValidity('')"
            />
          </div>
        </div>

        <div class="field">
          <label for="password">Password or Passkey</label>
          <div class="password-wrapper">
            <input 
              type="password" 
              id="password" 
              name="password" 
              required 
              minlength="6" 
            />
            <button type="button" class="toggle-btn" id="toggleBtn" onclick="togglePassword()">Show</button>
          </div>
          <div class="small-note">
            You may use your account password or assigned passkey.
          </div>
        </div>

        <div class="actions">
          <button type="submit" class="login-btn">Sign In</button>
          <button type="button" class="link-btn" onclick="handleForgotPassword()">
            Forgot Password?
          </button>
        </div>

      </form>

      <div class="back-link">
        <a href="/home">Go Back to Website</a>
      </div>

    </div>
  </div>
</body>
</html>
