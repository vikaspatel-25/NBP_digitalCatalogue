            </p>
          </section>

          <!-- 4. Licence Granted to the Website Operator -->
          <section class="space-y-2">
            <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
              <span class="w-6 h-6 rounded-lg bg-slate-900 text-white inline-flex items-center justify-center text-xs">4</span>
