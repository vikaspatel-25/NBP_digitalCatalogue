<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= article.title %> | NetZeroMart Insights</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  
  <link rel="icon" type="image/png" href="/assets/netZeroStickerIcon.png" />
  <link rel="apple-touch-icon" href="/assets/netZeroStickerIcon.png" />

  <meta name="description" content="<%= article.title %> - Read about sustainable industry practices and eco-technologies." />
  <meta property="og:title" content="<%= article.title %> - NetZeroMart" />
  <meta property="og:image" content="<%= article.coverImage || '/assets/netZeroStickerIcon.png' %>" />

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              blue: '#0158a0',
              green: '#529f23',
              darkBlue: '#004a87',
              darkGreen: '#044202'
            }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
          }
        }
      }
    }
  </script>
</head>
<body class="bg-slate-50 text-slate-900 antialiased font-sans flex flex-col min-h-screen selection:bg-blue-600 selection:text-white">
  <%- include('../components/header.ejs') %>

  <main class="flex-grow w-full py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs text-slate-500 font-medium mb-6">
        <a href="/home" class="hover:text-blue-600 transition-colors no-underline">Catalogue</a>
        <span>/</span>
        <span class="text-slate-400">Articles</span>
        <span>/</span>
        <span class="text-slate-800 font-bold truncate max-w-xs"><%= article.title %></span>
      </nav>

      <!-- Main Article Card -->
      <article class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-10 shadow-sm space-y-6">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-50 text-teal-700 text-xs font-bold border border-teal-100 uppercase tracking-wider">
            Educational Case Study
          </div>
          <h1 class="text-2xl sm:text-3xl md:text-4xl font-black text-slate-900 tracking-tight leading-snug">
            <%= article.title %>
          </h1>
          <div class="flex items-center gap-3 text-xs text-slate-400 font-medium pt-1">
            <span>Authored by: <strong class="text-slate-700"><%= article.userName === 'admin' ? 'NetZeroMart Editorial' : (article.userName || 'NetZeroMart') %></strong></span>
          </div>
        </div>

        <!-- Cover Image -->
        <% if (article.coverImage) { %>
          <div class="rounded-2xl overflow-hidden bg-slate-100 max-h-[480px] shadow-sm">
            <img src="<%= article.coverImage %>" alt="<%= article.title %>" class="w-full h-full object-cover" />
          </div>
        <% } %>

        <!-- Article Prose Content -->
        <div class="prose max-w-none text-slate-700 text-sm sm:text-base leading-relaxed space-y-4 pt-2">
          <%- article.content %>
        </div>

        <!-- Linked Catalog Products -->
        <% if (article.productLinks && article.productLinks.length) { %>
          <div class="mt-8 pt-6 border-t border-slate-100 space-y-3">
            <h2 class="text-sm font-bold uppercase tracking-wider text-slate-400">Referenced Product Listings</h2>
            <ul class="flex flex-col gap-2 p-0 m-0 list-none">
              <% article.productLinks.forEach(link => { %>
                <li class="p-3 bg-slate-50 rounded-xl border border-slate-100 hover:bg-slate-100 transition-colors">
                  <a href="<%= link %>" target="_blank" rel="noreferrer" class="text-xs font-semibold text-blue-600 hover:underline break-all">
                    <%= link %> ↗
                  </a>
                </li>
              <% }) %>
            </ul>
          </div>
        <% } %>
      </article>

    </div>
  </main>

  <%- include('../components/footer.ejs') %>
</body>
</html>