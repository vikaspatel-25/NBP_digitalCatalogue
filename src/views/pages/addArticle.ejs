<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Add Article</title>

<script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.8.2/tinymce.min.js"></script>

<style>

:root{
--bg:#f4f6f8;
--panel:#ffffff;
--border:#e5e7eb;
--text:#1f2937;
--muted:#6b7280;
--header-bg:#1e3a8a;
--success:#27ae60;
--primary:#2563eb;
--danger:#dc2626;
}

*{box-sizing:border-box}

body{
margin:0;
background:var(--bg);
font-family:system-ui;
display:flex;
justify-content:center;
padding:4vh 1rem;
}

.panel{
width:100%;
max-width:900px;
background:var(--panel);
border-radius:14px;
overflow:hidden;
box-shadow:0 12px 30px rgba(0,0,0,0.08);
}

.panel-header{
padding:1.6rem 2rem;
background:var(--header-bg);
color:white;
}

.panel-body{
padding:1.8rem 2rem;
}

.section{
margin-bottom:1.6rem;
padding:1.2rem;
border:1px solid var(--border);
border-radius:8px;
background:#fafbfc;
}

.section h2{
margin:0 0 10px 0;
font-size:1rem;
border-bottom:1px solid var(--border);
padding-bottom:4px;
}

label{
display:block;
margin-top:10px;
font-size:0.85rem;
color:var(--muted);
}

input[type=text],
input[type=url],
input[type=file]{
width:100%;
padding:0.6rem;
border-radius:6px;
border:1px solid var(--border);
margin-top:5px;
}

.btn{
padding:0.6rem 1rem;
border:none;
border-radius:6px;
background:var(--primary);
color:white;
cursor:pointer;
}

.btn-success{
background:var(--success);
}

.dynamic-item{
display:flex;
gap:10px;
margin-top:10px;
margin-bottom:10px;
align-items:center;
}

.dynamic-item input{
flex:1;
}

.dynamic-item button{
background:var(--danger);
color:white;
border:none;
border-radius:6px;
padding:4px 8px;
cursor:pointer;
}

.add-product-btn{
margin-top:10px;
}

.submit-section{
display:flex;
justify-content:space-between;
align-items:center;
margin-top:25px;
}

.loading-overlay{
position:fixed;
inset:0;
background:rgba(255,255,255,0.9);
display:none;
justify-content:center;
align-items:center;
z-index:999;
}

.loading-box{
background:white;
padding:30px 40px;
border-radius:8px;
box-shadow:0 6px 18px rgba(0,0,0,0.15);
text-align:center;
}

.spinner{
width:42px;
height:42px;
border:4px solid #e3e3e3;
border-top:4px solid var(--primary);
border-radius:50%;
margin:0 auto 15px;
animation:spin 1s linear infinite;
}

@keyframes spin{
to{transform:rotate(360deg)}
}

.loading-text{
font-size:14px;
color:var(--muted);
line-height:1.5;
}

</style>
</head>

<body>


<div id="editorLoader" class="loading-overlay" style="display:flex;">
<div class="loading-box">
<div class="spinner"></div>
<div class="loading-text">
Loading editor...
</div>
</div>
</div>


<div id="submitLoader" class="loading-overlay">

<div class="loading-box">

<div class="spinner"></div>

<div class="loading-text">

Uploading media files.<br>
This may take a few minutes.<br>
Please wait and do not close the page.

</div>

</div>

</div>



<div class="panel">

<div class="panel-header">
<h1>Add New Article</h1>
</div>

<div class="panel-body">

<form method="POST" enctype="multipart/form-data" onsubmit="handleSubmit()">

<div class="section">

<h2>Basic Info</h2>

<label>Article Title</label>
<input type="text" name="title" required>

</div>


<div class="section">

<h2>Cover Image</h2>

<input type="file" name="coverImage" accept="image/*">

</div>


<div class="section">

<h2>Article Content</h2>

<textarea id="editor" name="content"></textarea>

</div>



<div class="section">

<h2>Related Products (Optional)</h2>

<div id="productLinks"></div>

<button
type="button"
class="btn add-product-btn"
onclick="addProductLink()"
>

Add Product Link

</button>

</div>



<div class="submit-section">

<a id="backLink" style="text-decoration:none;font-size:14px;">
Back to Panel
</a>

<button id="submitBtn" type="submit" class="btn btn-success">
Publish Article
</button>

</div>

</form>

</div>

</div>


<script>


function addProductLink(){

const container=document.getElementById('productLinks');

const div=document.createElement('div');

div.className='dynamic-item';

div.innerHTML=`
<input type="url" name="productLinks[]" placeholder="Enter product URL">
<button type="button" onclick="removeItem(this)">X</button>
`;

container.appendChild(div);

}


function removeItem(btn){

btn.parentElement.remove();

}


function handleSubmit(){

tinymce.triggerSave();   // FIX: sync TinyMCE content to textarea

document.getElementById('submitLoader').style.display='flex';

const btn=document.getElementById('submitBtn');

btn.disabled=true;

btn.style.opacity='0.7';

}



tinymce.init({

selector:'#editor',

height:550,

menubar:true,

plugins:[
'lists','link','image','table','code','fullscreen','preview','autolink','media'
],

toolbar:
'undo redo | styles | bold italic underline strikethrough | alignleft aligncenter alignright alignjustify | bullist numlist | link image media table | blockquote code | fullscreen preview',

branding:false,

setup:function(editor){

editor.on('init',function(){

document.getElementById('editorLoader').style.display='none';

});

}

});


window.addEventListener('DOMContentLoaded',function(){

const segments=window.location.pathname.split('/').filter(Boolean);

const basePath='/' + segments[0];

document.getElementById('backLink').href=basePath;

});


</script>

</body>
</html>