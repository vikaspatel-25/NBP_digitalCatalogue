<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>User Management</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #e2e8f0;
      margin: 0;
      padding: 3rem 1rem;
      display: flex;
      justify-content: center;
    }

    .outer-card {
      background: #f9fafb;
      padding: 2rem;
      border-radius: 16px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.08);
      max-width: 1000px;
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    h1 {
      text-align: center;
      color: #1f2937;
      font-size: 2rem;
      margin-bottom: 1.5rem;
    }

    .user-card {
      background: #ffffff;
      border-radius: 12px;
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      padding: 1.8rem;
      box-shadow: 0 4px 18px rgba(0,0,0,0.05);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .user-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 28px rgba(0,0,0,0.12);
    }

    .user-info {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .user-info h3 {
      margin: 0;
      font-size: 1.3rem;
      font-weight: 600;
      color: #111827;
    }

    .user-info p {
      margin: 0;
      font-size: 0.95rem;
    }

    .user-info .email {
      color: #3b82f6;
      font-weight: 500;
    }

    .user-info .email a {
      color: inherit;
      text-decoration: none;
    }

    .user-info .mobile {
      color: #6b7280;
      font-style: italic;
      cursor: pointer;
    }

    .actions {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    button {
      padding: 0.5rem 1.2rem;
      border-radius: 6px;
      border: none;
      font-size: 0.9rem;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.2s ease;
    }

    .delete { background: #ef4444; color: white; }
    .delete:hover { background: #b91c1c; }

    .download { background: #3b82f6; color: white; }
    .download:hover { background: #1d4ed8; }

    .no-users {
      text-align: center;
      color: #6b7280;
      font-size: 1.1rem;
      margin-top: 2rem;
    }

    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.4);
      display: none;
      align-items: center;
      justify-content: center;
    }

    .modal {
      background: #ffffff;
      padding: 2rem;
      border-radius: 12px;
      max-width: 400px;
      width: 100%;
      text-align: center;
      box-shadow: 0 10px 28px rgba(0,0,0,0.2);
    }

    .modal h3 {
      margin-top: 0;
    }

    .modal-buttons {
      margin-top: 1.5rem;
      display: flex;
      justify-content: center;
      gap: 1rem;
    }

    .cancel {
      background: #e5e7eb;
      color: #111827;
    }

    @media (max-width: 700px) {
      .user-card {
        grid-template-columns: 1fr;
        gap: 0.75rem;
      }
      .actions {
        justify-content: flex-start;
      }
    }
  </style>

  <script>
    function copyToClipboard(text) {
      navigator.clipboard.writeText(text);
      alert('Mobile number copied: ' + text);
    }

    function openModal(userId) {
      document.getElementById('deleteUserId').value = userId;
      document.getElementById('modalOverlay').style.display = 'flex';
    }

    function closeModal() {
      document.getElementById('modalOverlay').style.display = 'none';
    }
  </script>
</head>

<body>
  <div class="outer-card">
    <h1>Registered Users</h1>

    <% if (users && users.length > 0) { %>
      <% users.forEach(user => { %>
        <div class="user-card">
          <div class="user-info">
            <h3><%= user.companyName %></h3>
            <p class="email">
              Email:
              <a href="https://mail.google.com/mail/?view=cm&fs=1&to=<%= user.email %>" target="_blank">
                <%= user.email %>
              </a>
            </p>
            <p class="mobile" onclick="copyToClipboard('<%= user.mobile %>')">
              Mobile: <%= user.mobile %>
            </p>
          </div>

          <div class="actions">
            <% if (user.document && user.document.url && user.document.url !== '') { %>
              <a href="<%= user.document.url %>" target="_blank">
                <button class="download" type="button">Open Brochure</button>
              </a>
            <% } %>

            <button class="delete" onclick="openModal('<%= user._id %>')">
              Delete
            </button>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <p class="no-users">No registered users found.</p>
    <% } %>

    <a href="/admin" style="margin-top:20px;align-self:center;text-decoration:none;color:#1f2937;">
      <h5>Go Back to Admin Panel</h5>
    </a>
  </div>

  <div class="modal-overlay" id="modalOverlay">
    <div class="modal">
      <h3>Confirm Deletion</h3>
      <p>Are you sure you want to permanently remove this user?</p>
      <form action="/admin/userManagement" method="POST">
        <input type="hidden" name="userId" id="deleteUserId" />
        <div class="modal-buttons">
          <button type="button" class="cancel" onclick="closeModal()">Cancel</button>
          <button type="submit" class="delete">Confirm Delete</button>
        </div>
      </form>
    </div>
  </div>

</body>
</html>
